<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Sauce Lab Demo Test on Chrome Browser" verbose="4" thread-count="3" parallel="tests">

    <listeners>
        <listener class-name="com.qa.saucedemo.listeners.TestAllureListener"/>
        <listener class-name="com.qa.saucedemo.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Login Page Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.saucedemo.tests.LoginPageTest"/>
        </classes>
    </test>
</suite>